{
  "name": "@plurid/stringbase",
  "version": "0.0.0-1",
  "description": "An embedded document database stored in human-readable Deon",
  "keywords": [
    "database",
    "stringbase"
  ],
  "author": "ly3xqhl8g9 <ly3xqhl8g9@plurid.com> (https://plurid.com)",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/plurid/stringbase"
  },
  "bugs": {
    "email": "source@plurid.com",
    "url": "https://github.com/plurid/stringbase/issues"
  },
  "homepage": "https://github.com/plurid/stringbase/tree/master/packages/stringbase-javascript",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./distribution/index.cjs",
  "module": "./distribution/index.mjs",
  "bin": {
    "stringbase": "./distribution/cli.mjs"
  },
  "files": [
    "distribution"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm build && vitest run",
    "test:coverage": "vitest run --coverage",
    "check:docs": "node scripts/check-docs.mjs",
    "check:package": "node scripts/check-package.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test:coverage && pnpm check:docs && pnpm check:package",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm verify",
    "prepare:deon": "node scripts/prepare-deon.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1",
    "@plurid/deon": "github:plurid/deon#1fab7fb5bf32e03f4f491101c7aee6bf8b406c32&path:/packages/deon-javascript",
    "@plurid/loque": "github:plurid/loque#6bc497247cd862107cb68bfc3a6bbd99a0db50e0&path:/packages/loque-javascript"
  },
  "type": "module",
  "types": "./distribution/index.d.mts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./distribution/index.d.mts",
        "default": "./distribution/index.mjs"
      },
      "require": {
        "types": "./distribution/index.d.cts",
        "default": "./distribution/index.cjs"
      }
    },
    "./package.json": "./package.json"
  }
}
