{
  "name": "@plurid/stringbase-mcp",
  "version": "0.0.0-1",
  "description": "Controlled Stringbase agent workspaces over MCP",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/plurid/stringbase.git",
    "directory": "packages/stringbase-mcp"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./distribution/index.d.mts",
      "import": "./distribution/index.mjs"
    }
  },
  "bin": {
    "stringbase-mcp": "./distribution/cli.mjs"
  },
  "files": [
    "distribution"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config ../stringbase-javascript/eslint.config.mjs . --max-warnings 0",
    "test": "node --test tests/*.test.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@plurid/stringbase": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "6.0.3",
    "tsdown": "0.23.0",
    "eslint": "10.11.0"
  },
  "main": "./distribution/index.mjs",
  "types": "./distribution/index.d.mts",
  "sideEffects": false
}
